{
  "name": "OpenFoundry preview",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  "postCreateCommand": "npm install --global pnpm@9 && pnpm install --frozen-lockfile",
  "forwardPorts": [
    5173
  ],
  "portsAttributes": {
    "5173": {
      "label": "OpenFoundry",
      "onAutoForward": "openBrowser"
    }
  },
  "postStartCommand": "bash -c 'nohup pnpm dev --host 0.0.0.0 --port 5173 --strictPort </dev/null >/tmp/openfoundry-preview.log 2>&1 &'"
}
